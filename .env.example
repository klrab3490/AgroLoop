# Database configuration
POSTGRES_DB=agroloop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=7200
POSTGRES_PORT=5432

# Spring Datasource configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/agroloop
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=7200

# Server & Uploads
PORT=8080
UPLOAD_DIR=uploads

# pgAdmin (Optional - activate with: docker compose --profile tools up -d)
PGADMIN_PORT=5055
PGADMIN_EMAIL=admin@agroloop.local
PGADMIN_PASSWORD=admin

# Web Frontend (Next.js)
WEB_PORT=3000
BACKEND_API_URL=http://app:8080
NEXT_PUBLIC_API_URL=http://localhost:8080

# Platform Versioning & GitHub Releases
APP_VERSION=1.0.3
NEXT_PUBLIC_APP_VERSION=1.0.3
EXPO_PUBLIC_APP_VERSION=1.0.3
VITE_APP_VERSION=1.0.3
GITHUB_REPO=AgnaMariya/AgroLoop
NEXT_PUBLIC_GITHUB_REPO=AgnaMariya/AgroLoop
EXPO_PUBLIC_GITHUB_REPO=AgnaMariya/AgroLoop
VITE_GITHUB_REPO=AgnaMariya/AgroLoop

# ngrok Tunnels (Optional - activate with: docker compose --profile tunnel up -d)
NGROK_AUTHTOKEN=
NGROK_WEB_PORT=4040
NGROK_API_PORT=4041
