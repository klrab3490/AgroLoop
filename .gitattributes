# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files you want to always be normalized and converted
# to native line endings on checkout.
*.java text
*.xml text
*.properties text
*.yml text
*.yaml text
*.html text
*.css text
*.js text
*.md text
*.sql text

# Bash scripts must always have LF line endings
*.sh text eol=lf
mvnw text eol=lf

# Windows batch scripts must always have CRLF line endings
*.bat text eol=crlf
*.cmd text eol=crlf
mvnw.cmd text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
