{
  "name": "agroloop-clients-workspace",
  "version": "1.0.7",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:web": "playwright test --project=web-ui",
    "test:e2e:desktop": "playwright test --project=desktop-ui",
    "test:e2e:users": "playwright test e2e/all-seeded-users.spec.ts --project=web-ui",
    "test:e2e:record": "RECORD_VIDEO=on SLOWMO=500 playwright test",
    "codegen:api": "turbo codegen:api"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}