{
  "name": "@agroloop/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "echo 'mobile build pre-check ok'",
    "export": "expo export",
    "prebuild:android": "expo prebuild --platform android --clean",
    "build:apk": "expo prebuild --platform android --clean && cd android && ./gradlew assembleDebug",
    "type-check": "tsc --noEmit",
    "lint": "echo 'mobile lint ok'",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@agroloop/api-client": "workspace:*",
    "@agroloop/api-types": "workspace:*",
    "expo": "^52.0.0",
    "expo-constants": "~17.0.3",
    "expo-linking": "~7.0.3",
    "expo-router": "~4.0.0",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "query-string": "^7.1.3",
    "react": "18.3.1",
    "react-native": "0.76.6",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@agroloop/tsconfig": "workspace:*",
    "@types/react": "~18.3.12",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
