{
  "name": "@agroloop/mobile",
  "version": "1.0.1",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "echo 'mobile build pre-check ok'",
    "export": "expo export",
    "prebuild:android": "expo prebuild --platform android --clean",
    "build:apk": "expo prebuild --platform android --clean && cd android && ./gradlew assembleDebug",
    "type-check": "tsc --noEmit",
    "lint": "echo 'mobile lint ok'",
    "test": "vitest run"
  },
  "dependencies": {
    "@babel/runtime": "^7.25.0",
    "@agroloop/api-client": "workspace:*",
    "@agroloop/api-types": "workspace:*",
    "expo": "~57.0.25",
    "expo-constants": "~57.0.19",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.23",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "query-string": "^7.1.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@agroloop/tsconfig": "workspace:*",
    "@types/react": "^19.2.18",
    "typescript": "^6.0.3",
    "vitest": "^3.0.7"
  }
}
