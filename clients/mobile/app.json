{
  "expo": {
    "name": "AgroLoop Mobile",
    "slug": "agroloop-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "agroloop",
    "userInterfaceStyle": "automatic",
    "platforms": ["ios", "android"],
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.agroloop.mobile",
      "infoPlist": {
        "NSCameraUsageDescription": "AgroLoop requires camera access to verify organic waste sorting and pickup validation.",
        "NSPhotoLibraryUsageDescription": "AgroLoop allows selecting photos of waste materials for verification."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.agroloop.mobile",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "AgroLoop allows selecting photos of waste materials for verification.",
          "cameraPermission": "AgroLoop requires camera access to verify organic waste sorting and pickup validation."
        }
      ]
    ]
  }
}
