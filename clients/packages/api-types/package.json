{
  "name": "@agroloop/api-types",
  "version": "1.0.5",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "codegen:api": "openapi-typescript ../../openapi/openapi.json -o src/generated/schema.ts",
    "build": "pnpm run codegen:api && tsc",
    "type-check": "tsc --noEmit",
    "lint": "echo 'api-types lint ok'"
  },
  "devDependencies": {
    "@agroloop/tsconfig": "workspace:*",
    "openapi-typescript": "^7.6.1",
    "typescript": "^5.7.3"
  }
}